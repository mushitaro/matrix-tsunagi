{
  // `@/` is each tool's own alias. esbuild resolves it per repository, through each submodule's
  // own tsconfig; tsc reads only this file, so `@/` tries TUNER first and SMG2 second — the one
  // SMG2 path reached from here (`@/lib/factory/reference`, a type) exists only in SMG2.
  // `@smg2/*` is how src/ names SMG2's app code, and `@tsunagi/*` are SMG2's workspace packages.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./vendor/tuner/src/*", "./vendor/smg2/src/*", "./vendor/m35080/web/*"],
      "@boot/*": ["./vendor/boot/packages/dme-flash/src/*"],
      "@m35080/*": ["./vendor/m35080/web/*"],
      "@smg2/*": ["./vendor/smg2/src/*"],
      "@tsunagi/xdf-engine": ["./vendor/smg2/packages/xdf-engine/src/index.ts"],
      "@tsunagi/ds2-smg2": ["./vendor/smg2/packages/ds2-smg2/src/index.ts"],
      "@tsunagi/ds2-core": ["./vendor/smg2/packages/ds2-core/src/index.ts"],
      "@tsunagi/ds2-core/*": ["./vendor/smg2/packages/ds2-core/src/*"]
    }
  },
  "include": ["src/**/*.ts", "remote/**/*.ts"]
}
