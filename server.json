{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.mushitaro/matrix-tsunagi-mapping",
  "title": "TSUNAGI///Matrix — MAPPING",
  "description": "BMW E46 M3 DME and SMG II: VE and rf_korr from Testo logs, decode SMG calibrations. Local.",
  "version": "0.4.0",
  "websiteUrl": "https://m3.tsunagi.app",
  "repository": {
    "url": "https://github.com/mushitaro/matrix-tsunagi",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "matrix-tsunagi",
      "version": "0.4.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "positional",
          "value": "mapping"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://matrix-mcp.tsunagi.app/mcp/mapping"
    }
  ]
}
