{
  "name": "matrix-tsunagi",
  "version": "0.4.0",
  "description": "TSUNAGI///Matrix — the BMW E46 M3 tools' calculations as a library, a CLI and MCP servers. MSS54HP DME: VE and rf_korr corrections from Testo logs. SMG II: decode and compare the gearbox calibration. DME backups and cluster M35080 EEPROMs: read and verify. No car, no cable, nothing sent.",
  "keywords": [
    "bmw",
    "e46",
    "m3",
    "csl",
    "mss54hp",
    "s54",
    "dme",
    "ecu",
    "tuning",
    "ve-table",
    "testo",
    "mcp",
    "tsunagi-matrix",
    "smg",
    "smg2",
    "smg-ii",
    "tcu",
    "xdf",
    "tunerpro",
    "m35080",
    "eeprom",
    "odometer",
    "bootloader",
    "kombi"
  ],
  "homepage": "https://github.com/mushitaro/matrix-tsunagi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mushitaro/matrix-tsunagi.git"
  },
  "bugs": "https://github.com/mushitaro/matrix-tsunagi/issues",
  "license": "MIT",
  "author": "TSUNAGI (https://m3.tsunagi.app)",
  "mcpName": "io.github.mushitaro/matrix-tsunagi-mapping",
  "type": "module",
  "bin": {
    "matrix-tsunagi": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./mapping": "./dist/mapping.js",
    "./migration": "./dist/migration.js",
    "./mcp": "./dist/mcp.js"
  },
  "files": [
    "dist",
    "samples",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "THIRD-PARTY-LICENSES.txt"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "verify:golden": "node scripts/verify-golden.mjs",
    "verify:line": "node scripts/verify-line.mjs",
    "verify:mcp": "node scripts/verify-mcp.mjs",
    "verify": "npm run build && npm run typecheck && npm run verify:golden && npm run verify:line && npm run verify:smg2 && npm run verify:migration && npm run verify:mcp",
    "prepublishOnly": "npm run verify",
    "verify:smg2": "node scripts/verify-smg2.mjs",
    "verify:migration": "node scripts/verify-migration.mjs",
    "plugin:pack": "node scripts/pack-plugin.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@types/node": "^22.20.4",
    "@types/papaparse": "5.5.2",
    "esbuild": "^0.28.2",
    "papaparse": "5.5.3",
    "typescript": "^5.9.3",
    "zod": "^3.25.76"
  }
}
